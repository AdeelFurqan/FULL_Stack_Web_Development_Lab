const results = [
  { id: 1, name: 'Ali', department: 'CS', course: 'FSWD', marks: 82 },
  { id: 2, name: 'Sara', department: 'CS', course: 'FSWD', marks: 91 },
  { id: 3, name: 'Usman', department: 'SE', course: 'FSWD', marks: 47 },
  { id: 4, name: 'Hina', department: 'AI', course: 'FSWD', marks: 73 },
  { id: 5, name: 'Ahmed', department: 'SE', course: 'FSWD', marks: 64 },
  { id: 6, name: 'Zoya', department: 'AI', course: 'FSWD', marks: 91 },
];

// ---------- A. Grade, status, gradePoints ----------
function getGrade(marks) {
  if (marks >= 85) return { grade: 'A', gradePoints: 4.0 };
  if (marks >= 80) return { grade: 'A-', gradePoints: 3.67 };
  if (marks >= 75) return { grade: 'B+', gradePoints: 3.33 };
  if (marks >= 70) return { grade: 'B', gradePoints: 3.0 };
  if (marks >= 65) return { grade: 'B-', gradePoints: 2.67 };
  if (marks >= 60) return { grade: 'C+', gradePoints: 2.33 };
  if (marks >= 50) return { grade: 'C', gradePoints: 2.0 };
  return { grade: 'F', gradePoints: 0 };
}

const processed = results.map((student) => {
  const { grade, gradePoints } = getGrade(student.marks);
  return { ...student, grade, gradePoints, status: grade === 'F' ? 'FAIL' : 'PASS' };
});
console.log('A. Processed results:');
console.table(processed);

// ---------- B. Ranked merit list ----------
// sort() MUTATES, so copy first with [...results]
const ranked = [...results].sort((a, b) => {
  if (b.marks !== a.marks) return b.marks - a.marks;
  return a.name.localeCompare(b.name);
});
console.log('\nB. Ranked list:', ranked.map((s) => `${s.name}(${s.marks})`).join(', '));
console.log('Original order unchanged:', results.map((s) => s.name).join(', '));

// ---------- C. Department statistics (works for ANY new department) ----------
function departmentStats(list) {
  const totals = list.reduce((acc, s) => {
    const d = acc[s.department] ?? { students: 0, sum: 0, highest: 0, passed: 0 };
    d.students += 1;
    d.sum += s.marks;
    d.highest = Math.max(d.highest, s.marks);
    if (s.marks >= 50) d.passed += 1;
    acc[s.department] = d;
    return acc;
  }, {});

  const stats = {};
  Object.keys(totals).forEach((dept) => {
    const { students, sum, highest, passed } = totals[dept];
    stats[dept] = { students, average: Number((sum / students).toFixed(2)), highest, passed };
  });
  return stats;
}
console.log('\nC. Department stats:', departmentStats(results));
console.log('With new DS dept:', departmentStats([...results, { id: 7, name: 'Bilal', department: 'DS', course: 'FSWD', marks: 88 }]).DS);

// ---------- D. Academic queries ----------
const overallAverage = results.reduce((sum, s) => sum + s.marks, 0) / results.length;

console.log('\nD. Queries');
console.log('First student > 85:', results.find((s) => s.marks > 85)?.name);
console.log('Index of first failed student:', results.findIndex((s) => s.marks < 50));
console.log('At least one failed?', results.some((s) => s.marks < 50));
console.log('All marks valid (0-100)?', results.every((s) => s.marks >= 0 && s.marks <= 100));
console.log(`Above average (${overallAverage.toFixed(2)}):`, results.filter((s) => s.marks > overallAverage).map((s) => s.name));
console.log('Top three:', ranked.slice(0, 3).map((s) => s.name));
results.forEach((s) => { if (s.marks < 50) console.log('forEach found failing student:', s.name); });
