<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Timetable</title>
<style>
  :root {
    --border: #333;
    --header-bg: #555;
    --day-bg: #777;
  }

  body {
    font-family: Arial, sans-serif;
    text-align: center;
    background: #f5f5f5;
  }

  table {
    border-collapse: collapse;
    width: 95%;
    margin: 20px auto;
    background: white;
  }

  th, td {
    border: 1px solid var(--border);
    padding: 12px;
    font-size: 14px;
  }

  th, .day {
    background: var(--header-bg);
    color: white;
  }

  .day {
    background: var(--day-bg);
    font-weight: bold;
  }
</style>
</head>
